{
  "name": "@wesleyvdk/yt-dlp-mcp",
  "version": "0.10.0",
  "description": "An MCP server implementation that integrates with yt-dlp, providing video and audio content download capabilities (e.g. YouTube, Facebook, Tiktok, etc.) for LLMs.",
  "keywords": [
    "mcp",
    "youtube",
    "yt-dlp",
    "dive",
    "llm"
  ],
  "homepage": "https://github.com/Wesleyvdk/yt-dlp-mcp#readme",
  "bugs": {
    "url": "https://github.com/Wesleyvdk/yt-dlp-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wesleyvdk/yt-dlp-mcp.git"
  },
  "bin": {
    "yt-dlp-mcp": "lib/index.mjs"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "main": "./lib/api.js",
  "types": "./lib/api.d.ts",
  "scripts": {
    "build": "tsc --skipLibCheck && node scripts/prepare.mjs",
    "prepare": "npm run build",
    "start": "node lib/index.mjs",
    "test": "node scripts/test.mjs",
    "test:smoke": "npm run build && node scripts/smoke.mjs",
    "test:integration": "node scripts/test.mjs --integration"
  },
  "engines": { "node": ">=22.12" },
  "contributors": ["Wesley van der Kraan"],
  "author": "Dewei Yen <k@funmula.com>",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/api.d.ts",
      "import": "./lib/api.js"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  }
}
